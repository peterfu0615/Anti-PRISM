<Window x:Class="AntiPrism.Tray.UI.FakeBrightnessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Display Brightness"
        Width="360" Height="100"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize">

    <Border Background="#202020"
            BorderBrush="#383838"
            BorderThickness="1"
            CornerRadius="10"
            Padding="16"
            Margin="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.45" Color="#000000" />
        </Border.Effect>

        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="50" />
            </Grid.ColumnDefinitions>

            <!-- Sun Icon (Path) -->
            <Viewbox Grid.Column="0" Width="24" Height="24" Margin="0,0,12,0" VerticalAlignment="Center">
                <Canvas Width="24" Height="24">
                    <Path Fill="#E0E0E0" Data="M12,7 A5,5 0 1,0 12,17 A5,5 0 1,0 12,7 M12,2 L12,4 M12,20 L12,22 M2,12 L4,12 M20,12 L22,12 M4.93,4.93 L6.34,6.34 M17.66,17.66 L19.07,19.07 M4.93,19.07 L6.34,17.66 M17.66,6.34 L19.07,4.93"
                          Stroke="#E0E0E0" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Canvas>
            </Viewbox>

            <!-- Brightness Slider -->
            <Slider x:Name="BrightnessSlider"
                    Grid.Column="1"
                    Minimum="0"
                    Maximum="100"
                    Value="50"
                    TickFrequency="1"
                    IsSnapToTickEnabled="True"
                    VerticalAlignment="Center"
                    ValueChanged="BrightnessSlider_ValueChanged" />

            <!-- Percentage Label -->
            <TextBlock x:Name="BrightnessLabel"
                       Grid.Column="2"
                       Text="50%"
                       Foreground="#FFFFFF"
                       FontSize="14"
                       FontFamily="Segoe UI Variable, Segoe UI"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center" />
        </Grid>
    </Border>
</Window>
